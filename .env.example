# ===== apps/api =====
PORT=3000
DATABASE_URL=postgres://evergrow:evergrow@localhost:5432/evergrow
REDIS_URL=redis://localhost:6379

# 管理端令牌（/admin/* 接口校验 x-admin-token；留空则管理端禁用）
ADMIN_TOKEN=

# LLM 接入（可选；不配则 AI 功能回落到规则解析模式）
# 提供商：openai | anthropic | deepseek | qwen | tencent | custom
LLM_PROVIDER=
# 对应平台的密钥（只放在这里，绝不写入数据库/管理页面）
LLM_API_KEY=
# 覆盖默认接入点（可选；如本地 Ollama http://localhost:11434/v1）
LLM_BASE_URL=
# 覆盖默认模型（可选；管理页可在运行时热切换，无需重启）
LLM_MODEL=
# 采样温度（可选，默认 0.3；字段提取类建议 0.2 左右）
LLM_TEMPERATURE=

# S3 兼容对象存储（本地 MinIO / 生产 OSS）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=evergrow
