{
  "name": "@evergrow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "@effect/sql": "^0.52.1",
    "@effect/sql-pg": "^0.53.0",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@evergrow/eslint-config": "workspace:*",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
